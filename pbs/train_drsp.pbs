#!/bin/bash
#PBS -N ouro_drsp
#PBS -q regular-g
#PBS -W group_list=gn77
#PBS -l select=3:mpiprocs=1
#PBS -l walltime=24:00:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
: "${DRSP_STUDY_ROOT:?frozen study directory required}"
code_dir="$DRSP_STUDY_ROOT/code_snapshot"
python3 "$code_dir/scripts/drsp_study.py" --dispatch "$DRSP_STUDY_ROOT"
